    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "prisma": "^7.10.0",
    "shadcn": "^4.21.5",
    "tailwindcss": "^4",
