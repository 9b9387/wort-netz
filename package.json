    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^1.57.0",
    "next": "16.4.1",
    "node-html-parser": "^9.0.4",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
