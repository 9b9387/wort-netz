generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id          String   @id @db.Uuid
  displayName String?  @map("display_name")
  uiLocale    String   @default("zh") @map("ui_locale")
  /// Whether the AI assistant sidebar is expanded, remembered per user.
  aiPanelOpen Boolean  @default(true) @map("ai_panel_open")
  /// Review plan: cards per session, new words introduced per local day.
  reviewSessionSize Int @default(20) @map("review_session_size")
  reviewNewPerDay   Int @default(20) @map("review_new_per_day")
  /// Last known UTC offset, using the JavaScript `Date#getTimezoneOffset()`
  /// sign convention (UTC+8 is -480). Used to cut "today" into local days.
  reviewTzOffsetMinutes Int @default(-480) @map("review_tz_offset_minutes")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  encounters        Encounter[]
  userLexemes       UserLexeme[]
  wordNotes         UserWordNote[]
  llmConfig         UserLlmConfig?
  aiThreads         AiThread[]
  aiMessages        AiMessage[]
  articles          Article[]
  reviewLogs        ReviewLog[]
  aiReviewSentences AiReviewSentence[]

  @@map("profiles")
}

model Lexeme {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  normalizedLemma     String    @unique @map("normalized_lemma")
  canonicalLemma      String    @map("canonical_lemma")
  wordType            String?   @map("word_type")
  gender              String?
  frequencyClass      Int?      @map("frequency_class") @db.SmallInt
  ipa                 String?
  dwdsUrl             String?   @map("dwds_url")
  definitionEn        String?   @map("definition_en")
  /// Structured English senses (text, part of speech, tags, source order) from
  /// every German entry the dictionary returned, so the UI can rank and list
  /// them instead of trusting the order of a newline-joined string.
  sensesJson          Json?     @map("senses_json")
  formsJson           Json?     @map("forms_json")
  dictionaryUrl       String?   @map("dictionary_url")
  dictionarySource    String?   @map("dictionary_source")
  dictionaryLicense   String?   @map("dictionary_license")
  dictionaryFetchedAt DateTime? @map("dictionary_fetched_at") @db.Timestamptz(6)
  sourceJson          Json      @default("{}") @map("source_json")
  sourceFetchedAt     DateTime  @default(now()) @map("source_fetched_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  encounters       Encounter[]
  userLexemes      UserLexeme[]
  wordNotes        UserWordNote[]
  lexemeSynsets    LexemeSynset[]
  vocabularyLevels LexemeVocabularyLevel[]
  aiThreads        AiThread[]
  relationsFrom    LexemeRelation[]        @relation("LexemeRelationSource")
  relationsTo      LexemeRelation[]        @relation("LexemeRelationTarget")
  reviewLogs       ReviewLog[]
  aiReviewSentences AiReviewSentence[]

  @@index([wordType])
  @@index([frequencyClass])
  @@map("lexemes")
}

model Encounter {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  lexemeId    String   @map("lexeme_id") @db.Uuid
  surfaceForm String   @map("surface_form")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  lexeme  Lexeme  @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, lexemeId, createdAt(sort: Desc)])
  @@map("encounters")
}

model UserLexeme {
  userId         String    @map("user_id") @db.Uuid
  lexemeId       String    @map("lexeme_id") @db.Uuid
  firstSeenAt    DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  encounterCount Int       @default(0) @map("encounter_count")
  isFavorite     Boolean   @default(false) @map("is_favorite")
  status         String    @default("NEW") @map("status")
  leitnerBox     Int       @default(0) @map("leitner_box")
  dueAt          DateTime? @map("due_at") @db.Timestamptz(6)
  intervalDays   Int       @default(0) @map("interval_days")
  easeFactor     Float     @default(2.5) @map("ease_factor")
  repetitions    Int       @default(0)
  lapses         Int       @default(0)
  lastReviewedAt DateTime? @map("last_reviewed_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  lexeme  Lexeme  @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  @@id([userId, lexemeId])
  @@index([userId, lastSeenAt(sort: Desc)])
  @@index([userId, status, dueAt])
  @@map("user_lexemes")
}

model UserWordNote {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  lexemeId           String    @map("lexeme_id") @db.Uuid
  content            String    @default("")
  aiIntroContent     String?   @map("ai_intro_content")
  aiIntroConfigHash  String?   @map("ai_intro_config_hash")
  aiIntroGeneratedAt DateTime? @map("ai_intro_generated_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  lexeme  Lexeme  @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  @@unique([userId, lexemeId])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("user_word_notes")
}

/// One answered review card. Append-only: rows are never rewritten, which keeps
/// the history usable as an audit trail and as the source of the daily stats.
model ReviewLog {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  lexemeId          String    @map("lexeme_id") @db.Uuid
  /// Client-generated id for the whole session, so logs can be grouped.
  sessionId         String    @map("session_id") @db.Uuid
  /// Client-generated id for one presentation of a card. The unique constraint
  /// below makes a retried submit a no-op instead of a second answer.
  clientCardId      String    @map("client_card_id") @db.Uuid
  /// FORGOT or KNOWN.
  rating            String
  boxBefore         Int       @map("box_before")
  boxAfter          Int       @map("box_after")
  intervalDaysAfter Int       @map("interval_days_after")
  /// Null once the card reached MASTERED and left the queue.
  dueAtAfter        DateTime? @map("due_at_after") @db.Timestamptz(6)
  elapsedMs         Int?      @map("elapsed_ms")
  tzOffsetMinutes   Int       @map("tz_offset_minutes")
  reviewedAt        DateTime  @default(now()) @map("reviewed_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  lexeme  Lexeme  @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  @@unique([sessionId, clientCardId])
  @@index([userId, reviewedAt(sort: Desc)])
  @@index([userId, lexemeId, reviewedAt(sort: Desc)])
  @@map("review_logs")
}

/// A sentence the user's own LLM generated because nothing in the dictionary
/// sources contained the word. Cached per user and lexeme, and regenerated when
/// the LLM configuration changes.
model AiReviewSentence {
  userId        String   @map("user_id") @db.Uuid
  lexemeId      String   @map("lexeme_id") @db.Uuid
  sentence      String
  translation   String
  highlightForm String   @map("highlight_form")
  configHash    String   @map("config_hash")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  lexeme  Lexeme  @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  @@id([userId, lexemeId])
  @@map("ai_review_sentences")
}

/// A pasted article the user annotates on /reader. There is no separate title
/// column: `excerpt` and `charCount` are derived from `content` on save and only
/// exist to keep the article list query cheap.
model Article {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  content   String   @default("")
  excerpt   String   @default("")
  charCount Int      @default(0) @map("char_count")
  /// Snapshot of the last annotation: how many distinct words were unlearned.
  /// `null` means the article has not been opened since the reader shipped.
  unlearnedCount Int? @map("unlearned_count")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt(sort: Desc)])
  @@map("articles")
}

model UserLlmConfig {
  userId           String   @id @map("user_id") @db.Uuid
  baseUrl          String   @map("base_url")
  apiKeyCiphertext Json     @map("api_key_ciphertext")
  model            String
  temperature      Float?
  maxTokens        Int?     @map("max_tokens")
  timeoutMs        Int?     @map("timeout_ms")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_llm_configs")
}

model AiThread {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  lexemeId      String?  @map("lexeme_id") @db.Uuid
  kind          String   @default("general")
  title         String?
  lastMessageAt DateTime @default(now()) @map("last_message_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile  Profile     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lexeme   Lexeme?     @relation(fields: [lexemeId], references: [id], onDelete: SetNull)
  messages AiMessage[]

  @@index([userId, lastMessageAt(sort: Desc)])
  @@index([lexemeId])
  @@map("ai_threads")
}

model AiMessage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  threadId   String   @map("thread_id") @db.Uuid
  role       String
  content    String
  model      String?
  configHash String?  @map("config_hash")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  profile Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread  AiThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([userId, createdAt(sort: Desc)])
  @@map("ai_messages")
}

model LexemeRelation {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceLexemeId        String   @map("source_lexeme_id") @db.Uuid
  targetLexemeId        String?  @map("target_lexeme_id") @db.Uuid
  targetLemma           String   @map("target_lemma")
  targetNormalizedLemma String   @map("target_normalized_lemma")
  relationType          String   @default("synonym") @map("relation_type")
  sourceName            String   @default("openthesaurus") @map("source_name")
  sourceData            Json     @default("{}") @map("source_data")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sourceLexeme Lexeme  @relation("LexemeRelationSource", fields: [sourceLexemeId], references: [id], onDelete: Cascade)
  targetLexeme Lexeme? @relation("LexemeRelationTarget", fields: [targetLexemeId], references: [id], onDelete: SetNull)

  @@unique([sourceLexemeId, targetNormalizedLemma, relationType, sourceName])
  @@index([sourceLexemeId, relationType])
  @@index([targetLexemeId, relationType])
  @@map("lexeme_relations")
}

model DwdsCache {
  endpoint  String
  query     String
  payload   Json
  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@id([endpoint, query])
  @@map("dwds_cache")
}

model WordnetSynset {
  id            String   @id
  ili           String?
  partOfSpeech  String?  @map("part_of_speech")
  descriptionEn String?  @map("description_en")
  subject       String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  definitions    WordnetDefinition[]
  examples       WordnetExample[]
  senses         WordnetSense[]
  relationsFrom  WordnetRelation[]      @relation("WordnetRelationSource")
  relationsTo    WordnetRelation[]      @relation("WordnetRelationTarget")
  senseRelations WordnetSenseRelation[]
  lexemeSynsets  LexemeSynset[]

  @@index([partOfSpeech])
  @@index([ili])
  @@map("wordnet_synsets")
}

model WordnetDefinition {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  synsetId  String   @map("synset_id")
  language  String   @default("de")
  text      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  synset WordnetSynset @relation(fields: [synsetId], references: [id], onDelete: Cascade)

  @@index([synsetId])
  @@map("wordnet_definitions")
}

model WordnetExample {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  synsetId  String?  @map("synset_id")
  text      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  synset WordnetSynset? @relation(fields: [synsetId], references: [id], onDelete: Cascade)

  @@index([synsetId])
  @@map("wordnet_examples")
}

model WordnetLexicalEntry {
  id              String   @id
  lemma           String
  normalizedLemma String   @map("normalized_lemma")
  partOfSpeech    String?  @map("part_of_speech")
  basicVocabulary Boolean  @default(false) @map("basic_vocabulary")
  confidenceScore Float?   @map("confidence_score")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  senses WordnetSense[]

  @@index([normalizedLemma, partOfSpeech])
  @@map("wordnet_lexical_entries")
}

model WordnetSense {
  id       String @id
  entryId  String @map("entry_id")
  synsetId String @map("synset_id")

  entry         WordnetLexicalEntry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  synset        WordnetSynset          @relation(fields: [synsetId], references: [id], onDelete: Cascade)
  relationsFrom WordnetSenseRelation[] @relation("WordnetSenseRelationSource")

  @@index([synsetId])
  @@index([entryId])
  @@map("wordnet_senses")
}

model WordnetRelation {
  sourceSynsetId String @map("source_synset_id")
  targetSynsetId String @map("target_synset_id")
  relType        String @map("rel_type")

  sourceSynset WordnetSynset @relation("WordnetRelationSource", fields: [sourceSynsetId], references: [id], onDelete: Cascade)
  targetSynset WordnetSynset @relation("WordnetRelationTarget", fields: [targetSynsetId], references: [id], onDelete: Cascade)

  @@id([sourceSynsetId, targetSynsetId, relType])
  @@index([sourceSynsetId, relType])
  @@index([targetSynsetId, relType])
  @@map("wordnet_relations")
}

model WordnetSenseRelation {
  sourceSenseId  String @map("source_sense_id")
  targetSynsetId String @map("target_synset_id")
  relType        String @map("rel_type")

  sourceSense  WordnetSense  @relation("WordnetSenseRelationSource", fields: [sourceSenseId], references: [id], onDelete: Cascade)
  targetSynset WordnetSynset @relation(fields: [targetSynsetId], references: [id], onDelete: Cascade)

  @@id([sourceSenseId, targetSynsetId, relType])
  @@index([sourceSenseId, relType])
  @@index([targetSynsetId, relType])
  @@map("wordnet_sense_relations")
}

model LexemeSynset {
  lexemeId   String   @map("lexeme_id") @db.Uuid
  synsetId   String   @map("synset_id")
  matchType  String   @default("exact") @map("match_type")
  confidence Float?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  lexeme Lexeme        @relation(fields: [lexemeId], references: [id], onDelete: Cascade)
  synset WordnetSynset @relation(fields: [synsetId], references: [id], onDelete: Cascade)

  @@id([lexemeId, synsetId])
  @@index([synsetId])
  @@map("lexeme_synsets")
}

model WordnetImport {
  id         String   @id
  version    String
  sourceUrl  String   @map("source_url")
  license    String
  importedAt DateTime @default(now()) @map("imported_at") @db.Timestamptz(6)
  statsJson  Json?    @map("stats_json")

  @@map("wordnet_imports")
}

model VocabularyLevel {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  level           String
  lemma           String
  normalizedLemma String   @map("normalized_lemma")
  partOfSpeech    String   @default("") @map("part_of_speech")
  translationEn   String?  @map("translation_en")
  exampleDe       String?  @map("example_de")
  source          String   @default("wordfeather")
  sourceUrl       String   @map("source_url")
  license         String
  confidence      Float?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([normalizedLemma, level, partOfSpeech])
  @@index([normalizedLemma])
  @@index([level])
  @@map("vocabulary_levels")
}

model LexemeVocabularyLevel {
  lexemeId   String   @map("lexeme_id") @db.Uuid
  level      String
  source     String   @default("wordfeather")
  confidence Float?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  lexeme Lexeme @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  @@id([lexemeId, level])
  @@index([level])
  @@map("lexeme_vocabulary_levels")
}

/// Cached example sentences fetched from the Tatoeba API, keyed by the
/// normalized lemma so repeated word-page visits never hit the network twice.
model TatoebaCache {
  query     String   @id
  payload   Json
  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@map("tatoeba_cache")
}
