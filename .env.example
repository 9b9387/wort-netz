# Supabase project settings (Dashboard -> Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Prisma connection strings (Dashboard -> Connect -> ORMs -> Prisma).
# Runtime client: pooled connection (Supavisor, port 6543).
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Prisma CLI: direct connection (port 5432) for migrations/introspection.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Optional override for the DWDS API base URL.
DWDS_BASE_URL=https://www.dwds.de/api

# Optional override for the OpenThesaurus JSON endpoint.
OPENTHESAURUS_BASE_URL=https://www.openthesaurus.de/synonyme/search
# OpenThesaurus asks for a User-Agent containing a real contact.
OPENTHESAURUS_USER_AGENT=WortNetz/0.1 (+https://your-domain.example)

# Optional override for the Tatoeba example-sentence API. Responses are cached in
# the tatoeba_cache table, so a lemma hits the network at most once a month.
TATOEBA_BASE_URL=https://tatoeba.org/en/api_v0

# Per-user LLM settings are encrypted with this server-side key.
# Generate one locally with: openssl rand -base64 32
LLM_CONFIG_ENCRYPTION_KEY=gKLieQ+AbBi29n1BJkFZ0RLKRZtBc2yj3thmHXgWMX4=

# Defaults shown in the AI settings form. Users may override them per account.
LLM_DEFAULT_BASE_URL=https://api.openai.com/v1
LLM_DEFAULT_MODEL=gpt-4o-mini
LLM_DEFAULT_TEMPERATURE=0.4
LLM_DEFAULT_MAX_TOKENS=4096
LLM_REQUEST_TIMEOUT_MS=60000

# Required for stable Server Action references across instances.
# Generate one locally with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
